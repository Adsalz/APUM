# Configuration pour l'extension firestore-send-email

# Type d'authentification - Username/Password pour Gmail
AUTHENTICATION_TYPE=Username & Password

# URI de connexion SMTP avec le mot de passe d'application
SMTP_CONNECTION_URI=smtps://adriensalles@gmail.com@smtp.gmail.com:465

# Mot de passe d'application Gmail
SMTP_PASSWORD=jpue mzab ydne sbrg

# Collection où les emails sont stockés
MAIL_COLLECTION=email_queue

# Adresse d'expédition par défaut
DEFAULT_FROM=adriensalles@gmail.com

# Adresse de réponse par défaut
DEFAULT_REPLY_TO=adriensalles@gmail.com

# Collection des utilisateurs (optionnel)
USERS_COLLECTION=users

# Collection des templates (optionnel)
TEMPLATES_COLLECTION=

# Instance Firestore
FIRESTORE_INSTANCE_ID=(default)

# Location Firestore
FIRESTORE_INSTANCE_LOCATION=

# TTL Configuration
TTL_EXPIRE_TYPE=Never
TTL_EXPIRE_VALUE=

# Options TLS
TLS_OPTIONS={}