rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Fonctions utilitaires ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && currentUser().role == 'admin';
    }

    function isMedecin() {
      return isSignedIn() && currentUser().role == 'medecin';
    }

    // Saisie des desiderata close par l'admin (config/saisie.fermee). Document
    // absent ou champ absent = saisie ouverte : c'était le fonctionnement
    // d'avant la clôture, il reste celui par défaut.
    function saisieFermee() {
      return exists(/databases/$(database)/documents/config/saisie) &&
        get(/databases/$(database)/documents/config/saisie).data.get('fermee', false) == true;
    }

    // ---------- Utilisateurs ----------
    match /users/{userId} {
      // Lecture : soi-même, les admins, et les médecins (annuaire nécessaire à l'interface)
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isMedecin());

      // Création / suppression : admins uniquement
      allow create, delete: if isAdmin();

      // Mise à jour : admin, ou l'utilisateur lui-même SANS pouvoir modifier son rôle
      // (empêche l'escalade de privilèges medecin -> admin)
      allow update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId &&
         request.resource.data.role == resource.data.role);
    }

    // ---------- Desiderata ----------
    // Un profil valide (médecin ou admin) est requis pour toute opération :
    // on exige (isMedecin() || isAdmin()) en plus des contrôles de propriété existants.
    // Une fois la saisie close (saisieFermee()), le médecin ne peut plus que
    // LIRE sa fiche ; l'admin garde la main pour reporter un changement accordé.
    match /desiderata/{desiderataId} {
      // Lecture : le propriétaire (médecin) ou un admin
      allow read: if (isMedecin() || isAdmin()) &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // Création : un médecin pour lui-même uniquement, saisie ouverte (ou un
      // admin pour n'importe qui, à tout moment)
      allow create: if (isMedecin() || isAdmin()) &&
        request.resource.data.userId is string &&
        (isAdmin() || (request.resource.data.userId == request.auth.uid && !saisieFermee()));

      // Mise à jour : le propriétaire (médecin), saisie ouverte, sans pouvoir
      // réattribuer le document à un autre médecin (userId immuable), ou un admin
      allow update: if isAdmin() ||
        (isMedecin() && resource.data.userId == request.auth.uid &&
         request.resource.data.userId == resource.data.userId &&
         !saisieFermee());

      // Suppression : le propriétaire (médecin) saisie ouverte, ou un admin
      allow delete: if isAdmin() ||
        (isMedecin() && resource.data.userId == request.auth.uid && !saisieFermee());
    }

    // ---------- Planning ----------
    match /planning/{planningId} {
      // Écriture : admins uniquement
      allow write: if isAdmin();
      // Lecture : tout utilisateur authentifié avec un rôle reconnu.
      // Exception : le document `periode_saisie` (uniquement { startDate, endDate })
      // est lisible PUBLIQUEMENT afin d'afficher la période de saisie en cours sur
      // la page de connexion (avant authentification). La condition `planningId ==
      // 'periode_saisie'` n'autorise QUE la lecture de ce document précis (un `get`) ;
      // elle ne rend PAS la collection listable publiquement, et ne touche ni à
      // l'écriture (admins seuls) ni aux autres documents planning.
      allow read: if isAdmin() || isMedecin() || planningId == 'periode_saisie';
    }

    // ---------- Queue d'emails ----------
    match /email_queue/{emailId} {
      // Lecture réservée aux admins
      allow read: if isAdmin();

      // Création / mise à jour : admins uniquement, avec validation de type des champs clés.
      // NB : l'app renseigne `to` sous forme de tableau (format de l'extension Trigger Email),
      // on accepte donc une liste OU une chaîne, dans les deux cas non vide.
      allow create, update: if isAdmin() &&
        request.resource.data.from is string &&
        request.resource.data.from.size() > 0 &&
        (
          (request.resource.data.to is list && request.resource.data.to.size() > 0) ||
          (request.resource.data.to is string && request.resource.data.to.size() > 0)
        );
      // TODO: épingler from == '<adresse de rôle>' une fois l'adresse de service définie

      // Suppression réservée aux admins
      allow delete: if isAdmin();
    }

    // ---------- Config publique : fenêtre d'inscription ----------
    // Le document config/inscription porte l'unique champ `open` (booléen) qui
    // indique si la réclamation des comptes médecin (« premier code = le sien »)
    // est ouverte. Lecture PUBLIQUE : la page de connexion en a besoin avant
    // toute authentification. Écriture admin uniquement.
    match /config/inscription {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.data.keys().hasOnly(['open']) &&
        request.resource.data.open is bool;
    }

    // ---------- Config publique : clôture de la saisie des desiderata ----------
    // config/saisie porte `fermee` (booléen) et, quand la saisie est close,
    // `fermeeLe` (horodatage serveur). Lu par saisieFermee() ci-dessus pour
    // refuser toute écriture de desiderata par un médecin. Lecture PUBLIQUE,
    // comme planning/periode_saisie qu'il accompagne : la page de connexion
    // l'affiche avant authentification. Écriture admin uniquement.
    match /config/saisie {
      allow read: if true;
      allow write: if isAdmin() &&
        request.resource.data.keys().hasOnly(['fermee', 'fermeeLe']) &&
        request.resource.data.fermee is bool &&
        (!('fermeeLe' in request.resource.data) || request.resource.data.fermeeLe is timestamp);
    }

    // ---------- Annuaire public (liste de connexion des médecins) ----------
    // Lecture PUBLIQUE et non authentifiée : la liste déroulante de login est
    // peuplée AVANT toute connexion (request.auth == null). NE JAMAIS remplacer
    // `if true` par isMedecin() ou une fonction appelant get(users/uid) : cela
    // déclencherait get(users/null) et REFUSERAIT la lecture, cassant le login
    // pour tout le monde. `read` couvre get ET list (getDocs). Le catch-all
    // `if false` plus bas ne l'annule pas (Firestore combine les règles en OR).
    match /annuaire/{docId} {
      allow read: if true;

      // Écriture réservée aux admins, avec validation stricte des champs
      // (uniquement label + email, tous deux des chaînes non vides). Empêche
      // tout médecin d'empoisonner l'annuaire (redirection de login d'un
      // confrère vers un autre email, labels trompeurs).
      allow create, update: if isAdmin() &&
        request.resource.data.keys().hasOnly(['label', 'email']) &&
        request.resource.data.label is string &&
        request.resource.data.label.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() > 0;

      allow delete: if isAdmin();
    }

    // ---------- Par défaut : tout refuser ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
