rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Fonctions utilitaires ----------
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && currentUser().role == 'admin';
    }

    function isMedecin() {
      return isSignedIn() && currentUser().role == 'medecin';
    }

    // ---------- Utilisateurs ----------
    match /users/{userId} {
      // Lecture : soi-même, les admins, et les médecins (annuaire nécessaire à l'interface)
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isMedecin());

      // Création / suppression : admins uniquement
      allow create, delete: if isAdmin();

      // Mise à jour : admin, ou l'utilisateur lui-même SANS pouvoir modifier son rôle
      // (empêche l'escalade de privilèges medecin -> admin)
      allow update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == userId &&
         request.resource.data.role == resource.data.role);
    }

    // ---------- Desiderata ----------
    // Un profil valide (médecin ou admin) est requis pour toute opération :
    // on exige (isMedecin() || isAdmin()) en plus des contrôles de propriété existants.
    match /desiderata/{desiderataId} {
      // Lecture : le propriétaire (médecin) ou un admin
      allow read: if (isMedecin() || isAdmin()) &&
        (resource.data.userId == request.auth.uid || isAdmin());

      // Création : un médecin pour lui-même uniquement (ou un admin pour n'importe qui)
      allow create: if (isMedecin() || isAdmin()) &&
        request.resource.data.userId is string &&
        (request.resource.data.userId == request.auth.uid || isAdmin());

      // Mise à jour : le propriétaire (médecin), sans pouvoir réattribuer le document
      // à un autre médecin (userId immuable), ou un admin
      allow update: if isAdmin() ||
        (isMedecin() && resource.data.userId == request.auth.uid &&
         request.resource.data.userId == resource.data.userId);

      // Suppression : le propriétaire (médecin) ou un admin
      allow delete: if isAdmin() ||
        (isMedecin() && resource.data.userId == request.auth.uid);
    }

    // ---------- Planning ----------
    match /planning/{planningId} {
      // Écriture : admins uniquement
      allow write: if isAdmin();
      // Lecture : tout utilisateur authentifié avec un rôle reconnu
      allow read: if isAdmin() || isMedecin();
    }

    // ---------- Queue d'emails ----------
    match /email_queue/{emailId} {
      // Lecture réservée aux admins
      allow read: if isAdmin();

      // Création / mise à jour : admins uniquement, avec validation de type des champs clés.
      // NB : l'app renseigne `to` sous forme de tableau (format de l'extension Trigger Email),
      // on accepte donc une liste OU une chaîne, dans les deux cas non vide.
      allow create, update: if isAdmin() &&
        request.resource.data.from is string &&
        request.resource.data.from.size() > 0 &&
        (
          (request.resource.data.to is list && request.resource.data.to.size() > 0) ||
          (request.resource.data.to is string && request.resource.data.to.size() > 0)
        );
      // TODO: épingler from == '<adresse de rôle>' une fois l'adresse de service définie

      // Suppression réservée aux admins
      allow delete: if isAdmin();
    }

    // ---------- Par défaut : tout refuser ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
