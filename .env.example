# Configuration Firebase - Template
# Copiez ce fichier vers .env et renseignez vos valeurs

REACT_APP_FIREBASE_API_KEY=votre_api_key_firebase
REACT_APP_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
REACT_APP_FIREBASE_DATABASE_URL=https://votre-projet-default-rtdb.region.firebasedatabase.app
REACT_APP_FIREBASE_PROJECT_ID=votre-projet-id
REACT_APP_FIREBASE_STORAGE_BUCKET=votre-projet.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=123456789
REACT_APP_FIREBASE_APP_ID=1:123456789:web:abcdef123456